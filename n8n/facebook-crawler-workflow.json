    {
      "parameters": {
        "jsCode": "// 取得上一個節點輸出的所有項目\nconst existingUrls = new Set($(\"Get Existing Record URLs\").first().json.urls);    \n\nconst items = $input.all();\n\n// 1. 設定你的「趨勢」門檻 (可以根據需求修改數字)\nconst MIN_LIKES = 20;      // 至少要 5 個讚\nconst MIN_COMMENTS = 15;   // 或至少要 5 則留言\nconst threshold = MIN_LIKES + MIN_COMMENTS\n// 2. 進行過濾與評分\nconst trendingPosts = items.filter(item => {\n  const p = item.json;\n  const total = (p.likes || 0) + (p.comments || 0);\n  \n  // 規格化當前貼文網址\n  const currentUrl = (p.post_url || \"\").trim().replace(/\\/$/, \"\").toLowerCase();\n  \n  // 判斷邏輯\n  const isNew = !existingUrls.has(currentUrl);\n  const isTrending = total >= threshold; // 改成 >= 包含剛好達標的\n\n  return isNew && isTrending;\n});\n\n// 3. 根據熱度排序 (讚 + 留言 + 轉傳*2) -> 讓最紅的排在最前面\ntrendingPosts.sort((a, b) => {\n  const scoreA = a.json.likes + a.json.comments + (a.json.reposts * 2);\n  const scoreB = b.json.likes + b.json.comments + (b.json.reposts * 2);\n  return scoreB - scoreA; // 由大到小排序\n});\n\nreturn trendingPosts;"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        656,
        240
      ],
      "id": "afef31d3-ce38-4a75-b861-3f601309f725",
      "name": "過濾貼文"
    },
    {
      "parameters": {
        "jsCode": "// 取得所有輸入的項目\nconst items = $input.all();\n\nreturn items.map(item => {\n  const data = item.json;\n\n  // 1. 基礎資訊\n  const created_time = data.time;\n  const author = data.user?.name || \"未知用戶\";\n  const postUrl = data.url || \"\";\n  const content = data.text || \"\";\n\n  // 2. 互動數據拆解 (Likes, Comments, Shares/Reposts)\n  const likes = data.likesCount || 0;\n  const comments = data.commentsCount || 0;\n  \n  // 註：在目前的 JSON 範例中沒有看到 \"sharesCount\" 欄位，\n  // 但通常 API 會回傳，這裡先預留，若無則顯示 0。\n  const reposts = data.sharesCount || 0; \n\n  // 3. 圖片文字與附件處理\n  const ocrText = data.attachments?.[0]?.ocrText || \"無圖片文字\";\n  const thumbnailUrl = data.attachments?.[0]?.thumbnail || \"\";\n\n  // 4. 自動偵測內文中的指令 (CTA)\n  const ctaMatch = content.match(/Comment \"([^\"]+)\"/i);\n  const cta = ctaMatch ? ctaMatch[1] : \"N/A\";\n\n  return {\n    json: {\n      created_time: created_time,\n      author: author,\n      likes: likes,\n      comments: comments,\n      reposts: reposts, // 轉傳/分享數\n      cta_keyword: cta,\n      post_url: postUrl,\n      image_ocr: ocrText,\n      image_url: thumbnailUrl,\n      content_summary: content.replace(/\\n/g, ' ') + \"...\",\n      full_text: content\n    }\n  };\n});"
      },
